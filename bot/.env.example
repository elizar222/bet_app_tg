# ── Рабочие боты ─────────────────────────────────────────────────────────────
# Токены ботов, которые будут писать пользователям. Через запятую.
# ВАЖНО: каждый из этих ботов должен быть добавлен АДМИНОМ во все каналы
# (право "Добавлять участников" / Invite users via link обязательно).
BOT_TOKENS=111:AAA,222:BBB,333:CCC

# ── Админ-бот ────────────────────────────────────────────────────────────────
# Отдельный бот только для управления. В каналы добавлять НЕ нужно.
# Пусто — админка работает в рабочем боте по команде /admin.
ADMIN_BOT_TOKEN=

# Telegram ID админов через запятую. Свой ID: @userinfobot
ADMIN_IDS=123456789

# ── Прочее ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
LOG_LEVEL=INFO

# Часовой пояс для планировщика (одобрение заявок, рассылки)
TIMEZONE=Europe/Moscow

# ── Мини-апп ─────────────────────────────────────────────────────────────────
# Сервер мини-аппа запускается вместе с ботами (python run.py).
WEB_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Публичный https-адрес мини-аппа.
#   auto  — бот сам поднимет бесплатный туннель cloudflared (для запуска на своём ПК)
#   https://... — свой домен на сервере
#   пусто — кнопка мини-аппа в боте не показывается
WEBAPP_URL=auto

# Для проверки в обычном браузере (http://127.0.0.1:8080) без Telegram:
# впиши свой Telegram ID. На боевом запуске оставь 0.
WEB_DEV_USER_ID=0
